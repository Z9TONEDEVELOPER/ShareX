<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShareX.ViewModels"
             xmlns:views="using:ShareX.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ShareX.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

     <Grid RowDefinitions="*,Auto">
         <ContentControl Grid.Row="0" Content="{Binding CurrentView}" Margin="0"/>
         <Border Grid.Row="1"
                 Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                 BorderBrush="{DynamicResource DividerBrush}"
                 BorderThickness="0 1 0 0">
             <TabControl TabStripPlacement="Bottom"
                         SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent"
                         BorderThickness="0">
                 <TabItem>
                     <TabItem.Header>
                         <StackPanel Spacing="4" VerticalAlignment="Center">
                             <PathIcon Data="M 12 2 L 12 14 L 19 14 L 19 2 Z M 5 9 L 5 21 L 12 21 L 12 9 Z" 
                                       Width="24" Height="24" />
                             <TextBlock Text="Отправить" FontSize="12" />
                         </StackPanel>
                     </TabItem.Header>
                     <views:SendView DataContext="{Binding SendViewModel}"/>
                 </TabItem>
                 <TabItem>
                     <TabItem.Header>
                         <StackPanel Spacing="4" VerticalAlignment="Center">
                             <PathIcon Data="M 5 2 L 5 14 L 12 14 L 12 2 Z M 12 9 L 12 21 L 19 21 L 19 9 Z" 
                                       Width="24" Height="24" />
                             <TextBlock Text="Получить" FontSize="12" />
                         </StackPanel>
                     </TabItem.Header>
                     <views:ReceiveView DataContext="{Binding ReceiveViewModel}" />
                 </TabItem>
                 <TabItem>
                     <TabItem.Header>
                         <StackPanel Spacing="4" VerticalAlignment="Center">
                             <PathIcon Data="M 4 4 L 4 20 L 20 20 L 20 4 Z M 8 8 L 16 8 M 8 12 L 16 12 M 8 16 L 13 16" 
                                       Width="24" Height="24" />
                             <TextBlock Text="История" FontSize="12" />
                         </StackPanel>
                     </TabItem.Header>
                     <TextBlock Text="История передач будет здесь" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                FontSize="18" Foreground="Gray"/>
                 </TabItem>
             </TabControl>
         </Border>
     </Grid>
</UserControl>
